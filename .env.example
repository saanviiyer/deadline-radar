# ============================================================================
# Deadline Radar — environment variables
# ============================================================================
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). Both are safe to expose in a client bundle:
# access is governed by the row-level-security policies in
# supabase/migrations/0001_init.sql.
#
# LEAVE THESE UNSET to run in zero-config mode: the app falls back to the static
# seed dataset (src/data/deadlines.ts) and localStorage for saved venues.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
